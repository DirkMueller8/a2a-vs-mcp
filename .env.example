# Copy to .env (which is git-ignored) and fill in your keys.

# OpenAI version (python -m agentcomms)
# Create a key at https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic / MCP version (python -m agentcomms.run_demo_mcp)
# Create a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=your-key-here
# claude-haiku-5-5 is the cheapest option; claude-opus-5-5 is the default
ANTHROPIC_MODEL=claude-opus-5-5
